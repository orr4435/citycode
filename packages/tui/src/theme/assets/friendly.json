{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "inkDark0": "#231f2e",
    "inkDark1": "#2c273a",
    "inkDark2": "#362f47",
    "inkDark3": "#443b59",
    "warmWhite": "#f5efe9",
    "softLavender": "#b9a9ff",
    "softLavenderDim": "#9483e0",
    "softLavenderHi": "#d3c6ff",
    "softPeach": "#ffb787",
    "softMint": "#8ee6bd",
    "softMintDim": "#5fc79a",
    "softAmber": "#ffd27a",
    "softCoral": "#ff9c94",
    "softSky": "#8fd2ff",
    "warmGray": "#a79cb8",
    "lightBg": "#faf6f0",
    "lightPaper": "#f2ebe3",
    "lightInk1": "#e8ded3",
    "lightText": "#3a3145",
    "lightGray": "#8a7f95"
  },
  "theme": {
    "primary": { "dark": "softLavender", "light": "softLavenderDim" },
    "secondary": { "dark": "softSky", "light": "softSky" },
    "accent": { "dark": "softPeach", "light": "softPeach" },
    "error": { "dark": "softCoral", "light": "softCoral" },
    "warning": { "dark": "softAmber", "light": "softAmber" },
    "success": { "dark": "softMint", "light": "softMintDim" },
    "info": { "dark": "softSky", "light": "softSky" },
    "text": { "dark": "warmWhite", "light": "lightText" },
    "textMuted": { "dark": "warmGray", "light": "lightGray" },
    "background": { "dark": "inkDark0", "light": "lightBg" },
    "backgroundPanel": { "dark": "inkDark1", "light": "lightPaper" },
    "backgroundElement": { "dark": "inkDark2", "light": "lightInk1" },
    "border": { "dark": "inkDark3", "light": "lightGray" },
    "borderActive": { "dark": "softLavender", "light": "softLavenderDim" },
    "borderSubtle": { "dark": "inkDark2", "light": "lightInk1" },
    "diffAdded": { "dark": "softMintDim", "light": "softMintDim" },
    "diffRemoved": { "dark": "softCoral", "light": "softCoral" },
    "diffContext": { "dark": "warmGray", "light": "lightGray" },
    "diffHunkHeader": { "dark": "softSky", "light": "softSky" },
    "diffHighlightAdded": { "dark": "#a8f0cb", "light": "#5da682" },
    "diffHighlightRemoved": { "dark": "#ffb3ac", "light": "#d5605a" },
    "diffAddedBg": { "dark": "#1c3328", "light": "#e6f4ec" },
    "diffRemovedBg": { "dark": "#332020", "light": "#f9e9e7" },
    "diffContextBg": { "dark": "inkDark1", "light": "lightPaper" },
    "diffLineNumber": { "dark": "textMuted", "light": "#6d6178" },
    "diffAddedLineNumberBg": { "dark": "#1a2e24", "light": "#dcefe3" },
    "diffRemovedLineNumberBg": { "dark": "#2e1c1c", "light": "#f3dcda" },
    "markdownText": { "dark": "warmWhite", "light": "lightText" },
    "markdownHeading": { "dark": "softSky", "light": "softSky" },
    "markdownLink": { "dark": "softSky", "light": "softSky" },
    "markdownLinkText": { "dark": "softLavenderHi", "light": "softLavenderDim" },
    "markdownCode": { "dark": "softMintDim", "light": "softMintDim" },
    "markdownBlockQuote": { "dark": "warmGray", "light": "lightGray" },
    "markdownEmph": { "dark": "softPeach", "light": "softPeach" },
    "markdownStrong": { "dark": "softAmber", "light": "softAmber" },
    "markdownHorizontalRule": { "dark": "warmGray", "light": "lightGray" },
    "markdownListItem": { "dark": "softSky", "light": "softSky" },
    "markdownListEnumeration": { "dark": "softLavenderHi", "light": "softLavenderDim" },
    "markdownImage": { "dark": "softSky", "light": "softSky" },
    "markdownImageText": { "dark": "softLavenderHi", "light": "softLavenderDim" },
    "markdownCodeBlock": { "dark": "warmWhite", "light": "lightText" },
    "syntaxComment": { "dark": "warmGray", "light": "lightGray" },
    "syntaxKeyword": { "dark": "softPeach", "light": "softPeach" },
    "syntaxFunction": { "dark": "softSky", "light": "softSky" },
    "syntaxVariable": { "dark": "warmWhite", "light": "lightText" },
    "syntaxString": { "dark": "softMintDim", "light": "softMintDim" },
    "syntaxNumber": { "dark": "softAmber", "light": "softAmber" },
    "syntaxType": { "dark": "softAmber", "light": "softAmber" },
    "syntaxOperator": { "dark": "softLavenderHi", "light": "softLavenderDim" },
    "syntaxPunctuation": { "dark": "warmWhite", "light": "lightText" }
  }
}
